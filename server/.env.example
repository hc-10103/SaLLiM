# 복사해서 .env로 쓰세요 (.env는 레포에 올리지 않음)
VISION_PROVIDER=mock          # mock | claude | gemini  (요금제·모델별 과금 조건 확인)
# SALLIM_DATA_DIR=../data     # 기본: 레포 루트 data/
# SALLIM_WEB_CACHE_PATH=../data/web_advice_cache.json  # 검색 답변 JSON. Docker Compose는 영구 볼륨으로 자동 설정
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5
# GEMINI_API_KEY=
# TAVILY_API_KEY=  # 목록 밖 분리배출 품목의 공식 자료 검색. 실제 값은 server/.env에만 저장
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_WEB_SEARCH_ENABLED=false  # 외부 웹 검색은 현재 기본 비활성화
# GEMINI_SEARCH_MODEL=gemini-3.5-flash-lite  # 목록 밖 물품의 Google 검색. 3.5 API 무료 등급에서는 사용 불가
